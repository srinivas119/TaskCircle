generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum MembershipStatus {
  ACTIVE
  PENDING
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  NEW_TASK
  DUE_TODAY
  DUE_TOMORROW
  OVERDUE
}

model User {
  id                String    @id @default(cuid())
  email             String?   @unique
  phone             String?   @unique
  name              String?
  username          String?   @unique
  profileImage      String?
  passwordHash      String?

  emailVerified Boolean @default(false)

  resetToken        String?
  resetTokenExpires DateTime?

  notifyNewTask       Boolean @default(true)
  notifyDueDate       Boolean @default(true)
  notifyOverdue       Boolean @default(true)
  notifyDailyReminder Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts AuthAccount[]
  sessions Session[]

  groupMemberships GroupMember[]
  createdGroups    Group[]       @relation("GroupCreator")
  joinRequests     JoinRequest[]

  assignedTasks Task[] @relation("AssignedTasks")
  createdTasks  Task[] @relation("CreatedTasks")

  notifications Notification[]
}

model AuthAccount {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  providerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  isValid   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OTPVerification {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, createdAt])
}

model Group {
  id          String       @id @default(cuid())
  groupCode   String       @unique
  name        String
  description String?
  privacy     GroupPrivacy @default(PRIVATE)
  creatorId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  members      GroupMember[]
  joinRequests JoinRequest[]
  tasks        Task[]

  @@index([creatorId])
  @@index([createdAt])
}

model GroupMember {
  id        String           @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole        @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  canAssignTasks Boolean          @default(false)
  joinedAt  DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([groupId, role])
  @@index([groupId, status])
}

model JoinRequest {
  id        String            @id @default(cuid())
  groupId   String
  userId    String
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([groupId, status])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  link        String?

  groupId    String
  assignedTo String
  createdBy  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  assignee User @relation("AssignedTasks", fields: [assignedTo], references: [id], onDelete: Cascade)

  creator User @relation("CreatedTasks", fields: [createdBy], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@index([groupId])
  @@index([assignedTo])
  @@index([createdBy])
  @@index([status])
  @@index([dueDate])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  taskId    String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
  @@index([userId, isRead])
  @@index([createdAt])
}