# Server
PORT=5000
NODE_ENV=development

# Session Encryption
# Needs to be a secure random string of at least 32 characters in production
SESSION_SECRET=dev-session-cookie-signing-secret-key

# Database — Replace with your Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/taskcircle?sslmode=require

# Google OAuth
# Never expose GOOGLE_CLIENT_SECRET to the frontend
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
